#!/bin/sh
set -eu

ROOT="${SECURE_APP_ROOT:-/srv/secure-apps}"
SHARE="${SECURE_APP_SHARE:-/usr/share/secure-app-appliance}"
RUNTIME_ENV="${SECURE_APP_RUNTIME_ENV:-/etc/secure-app-appliance/runtime.env}"
OPERATOR_ENV="/etc/secure-app-appliance/operator.env"
PRODUCT_PUBLIC_KEY="/etc/secure-app-appliance/product_unlock_ed25519.pub"
PRODUCT_ALLOWED_SIGNERS="/etc/secure-app-appliance/allowed_signers"
INSTALL_MARKER="/run/secure-app-appliance/installing"
UNLOCK_MARKER="/run/secure-app-appliance/unlocked"

GATEWAY_DIR="$ROOT/_gateway"
GATEWAY_CONTAINER="secure-app-gateway"
GATEWAY_NETWORK="secure-app-gateway"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

need_root() {
    if [ "$(id -u)" -eq 0 ]; then
        return
    fi

    command -v sudo >/dev/null 2>&1 || \
        die "sudo is required"

    exec sudo /usr/local/bin/appctl "$@"
}

load_operator_auth() {
    [ -r "$OPERATOR_ENV" ] || \
        die "operator configuration missing"

    [ -r "$PRODUCT_PUBLIC_KEY" ] || \
        die "product public key missing"

    [ -r "$PRODUCT_ALLOWED_SIGNERS" ] || \
        die "product allowed-signers file missing"

    . "$OPERATOR_ENV"

    : "${OPERATOR_USER:?OPERATOR_USER missing}"
    : "${PRODUCT_KEY_FINGERPRINT:?PRODUCT_KEY_FINGERPRINT missing}"
}

verify_product_session() {
    load_operator_auth

    session_user="${SUDO_USER:-$(id -un)}"

    [ "$session_user" = "$OPERATOR_USER" ] || \
        die "appctl is restricted to operator: $OPERATOR_USER"

    [ -n "${SSH_CONNECTION:-}" ] || \
        die "appctl requires an SSH session"

    [ -n "${SSH_USER_AUTH:-}" ] || \
        die "SSH authentication information is unavailable"

    [ -r "$SSH_USER_AUTH" ] || \
        die "SSH authentication information is unreadable"

    expected_blob="$(
        awk '{print $2}' "$PRODUCT_PUBLIC_KEY"
    )"

    awk \
        -v blob="$expected_blob" \
        '$1 ~ /^publickey/ && $3 == blob { found=1 } END { exit !found }' \
        "$SSH_USER_AUTH" || \
        die "SSH session was not authenticated with the product key"

    actual_fingerprint="$(
        ssh-keygen \
            -lf "$PRODUCT_PUBLIC_KEY" \
            -E sha256 |
        awk '{print $2}'
    )"

    [ "$actual_fingerprint" = "$PRODUCT_KEY_FINGERPRINT" ] || \
        die "installed product key fingerprint mismatch"

    [ -n "${SSH_AUTH_SOCK:-}" ] || \
        die "SSH agent forwarding is required"

    [ -S "$SSH_AUTH_SOCK" ] || \
        die "forwarded SSH agent socket is unavailable"

    tmpdir="$(mktemp -d)"
    challenge="$tmpdir/challenge"
    signature="$challenge.sig"

    {
        printf '%s\n' "secure-app-appliance"
        printf '%s\n' "$PRODUCT_KEY_FINGERPRINT"
        printf '%s\n' "$SSH_CONNECTION"
        openssl rand -hex 32
    } > "$challenge"

    if ! ssh-keygen \
        -Y sign \
        -q \
        -f "$PRODUCT_PUBLIC_KEY" \
        -n secure-app-appliance@local \
        "$challenge" \
        >/dev/null 2>&1
    then
        rm -rf "$tmpdir"
        die "product private key is not available through the forwarded SSH agent"
    fi

    if ! ssh-keygen \
        -Y verify \
        -q \
        -f "$PRODUCT_ALLOWED_SIGNERS" \
        -I secure-app-product \
        -n secure-app-appliance@local \
        -s "$signature" \
        < "$challenge" \
        >/dev/null 2>&1
    then
        rm -rf "$tmpdir"
        die "product private-key challenge verification failed"
    fi

    rm -rf "$tmpdir"

    echo "PRODUCT_AUTH=PASS"
    echo "PRODUCT_KEY_FINGERPRINT=$PRODUCT_KEY_FINGERPRINT"
}

appliance_is_unlocked() {
    [ -f "$UNLOCK_MARKER" ]
}

start_unlocked_apps() {
    [ -d "$ROOT" ] || return

    for dir in "$ROOT"/*
    do
        [ -d "$dir" ] || continue

        slug="$(basename "$dir")"

        [ "$slug" = "_gateway" ] && continue
        [ -r "$dir/state/applied.env" ] || continue
        [ -L "$dir/current" ] || continue

        echo "STARTING_APP=$slug"

        if preflight_app "$slug" >/dev/null 2>&1; then
            prepare_permissions "$slug"
            render_compose "$slug"
            compose_cmd "$slug" up -d
            echo "STARTED_APP=$slug"
        else
            echo "START_SKIPPED=$slug"
            echo "REASON=PREFLIGHT_FAILED"
        fi
    done
}

unlock_appliance() {
    install -d -m 0700 /run/secure-app-appliance

    if appliance_is_unlocked; then
        echo "APPLIANCE=UNLOCKED"
        return
    fi

    : > "$UNLOCK_MARKER"
    chmod 0600 "$UNLOCK_MARKER"

    echo "APPLIANCE=UNLOCKED"
    echo "UNLOCK_SOURCE=PRODUCT_KEY"

    start_unlocked_apps
}

lock_appliance() {
    [ -d "$ROOT" ] || {
        rm -f "$UNLOCK_MARKER"
        echo "APPLIANCE=LOCKED"
        return
    }

    for dir in "$ROOT"/*
    do
        [ -d "$dir" ] || continue

        slug="$(basename "$dir")"

        [ "$slug" = "_gateway" ] && continue
        [ -f "$dir/compose.yaml" ] || continue

        echo "STOPPING_APP=$slug"

        compose_cmd "$slug" stop >/dev/null 2>&1 || true
    done

    rm -f "$UNLOCK_MARKER"

    echo "APPLIANCE=LOCKED"
}

require_unlocked() {
    appliance_is_unlocked ||         die "appliance is locked"
}

valid_slug() {
    echo "$1" | grep -Eq '^[a-z0-9][a-z0-9-]*$'
}

cfg_get() {
    file="$1"
    key="$2"
    default="$3"

    value="$(
        awk -v key="$key" '
            /^[[:space:]]*#/ { next }
            /^[[:space:]]*$/ { next }

            {
                line=$0
                sub(/^[[:space:]]*/, "", line)

                split(line, a, "=")
                k=a[1]
                gsub(/[[:space:]]/, "", k)

                if (k == key) {
                    sub(/^[^=]*=/, "", line)
                    sub(/^[[:space:]]*/, "", line)
                    sub(/[[:space:]]*$/, "", line)
                    print line
                    exit
                }
            }
        ' "$file"
    )"

    if [ -n "$value" ]; then
        printf '%s' "$value"
    else
        printf '%s' "$default"
    fi
}

load_runtime() {
    [ -r "$RUNTIME_ENV" ] || \
        die "runtime metadata missing: $RUNTIME_ENV"

    . "$RUNTIME_ENV"

    : "${DEFAULT_RUNTIME_PROFILE:?DEFAULT_RUNTIME_PROFILE missing}"
    : "${RUNTIME_IMAGE_PREFIX:?RUNTIME_IMAGE_PREFIX missing}"
    : "${RUNTIME_VERSION:?RUNTIME_VERSION missing}"
    : "${REDIS_IMAGE:?REDIS_IMAGE missing}"
}

runtime_image_for_profile() {
    profile="$1"
    printf '%s:%s-%s' \
        "$RUNTIME_IMAGE_PREFIX" \
        "$profile" \
        "$RUNTIME_VERSION"
}

validate_runtime_profile() {
    profile="$1"

    echo "$profile" | grep -Eq '^php[0-9][0-9]$' || \
        die "invalid runtime profile: $profile"

    [ -r "$SHARE/runtime/profiles/$profile.env" ] || \
        die "runtime profile is not available: $profile"
}

ensure_runtime_profile() {
    profile="$1"

    validate_runtime_profile "$profile"

    image="$(runtime_image_for_profile "$profile")"

    if docker image inspect "$image" >/dev/null 2>&1; then
        return
    fi

    echo "RUNTIME_PROFILE=$profile"
    echo "RUNTIME_IMAGE=$image"
    echo "RUNTIME_STATUS=BUILD_REQUIRED"

    "$SHARE/builder/build-shared-runtime.sh" "$profile"

    docker image inspect "$image" >/dev/null 2>&1 || \
        die "runtime build did not create image: $image"
}

app_root() {
    printf '%s/%s' "$ROOT" "$1"
}

app_runtime_profile() {
    slug="$1"
    dir="$(app_root "$slug")"
    runtime_cfg="$dir/config/runtime.cfg"

    load_runtime

    if [ -r "$runtime_cfg" ]; then
        cfg_get "$runtime_cfg" RUNTIME_PROFILE "$DEFAULT_RUNTIME_PROFILE"
    else
        printf '%s' "$DEFAULT_RUNTIME_PROFILE"
    fi
}

write_runtime_profile() {
    slug="$1"
    profile="$2"
    dir="$(app_root "$slug")"
    runtime_cfg="$dir/config/runtime.cfg"
    temp="$runtime_cfg.new"

    validate_runtime_profile "$profile"

    printf 'RUNTIME_PROFILE=%s\n' "$profile" > "$temp"
    chmod 0644 "$temp"
    mv "$temp" "$runtime_cfg"
}

list_runtime_profiles() {
    load_runtime

    for file in "$SHARE"/runtime/profiles/*.env
    do
        [ -r "$file" ] || continue

        profile="$(cfg_get "$file" RUNTIME_PROFILE "")"
        php_version="$(cfg_get "$file" PHP_VERSION "")"

        [ -n "$profile" ] || continue

        image="$(runtime_image_for_profile "$profile")"

        if docker image inspect "$image" >/dev/null 2>&1; then
            state="INSTALLED"
        else
            state="NOT_INSTALLED"
        fi

        printf '%s\tPHP=%s\t%s\t%s\n'             "$profile"             "$php_version"             "$state"             "$image"
    done
}

runtime_status_app() {
    slug="$1"
    dir="$(app_root "$slug")"

    [ -d "$dir" ] ||         die "application is not installed: $slug"

    profile="$(app_runtime_profile "$slug")"

    validate_runtime_profile "$profile"

    file="$SHARE/runtime/profiles/$profile.env"
    php_version="$(cfg_get "$file" PHP_VERSION "")"
    image="$(runtime_image_for_profile "$profile")"

    if docker image inspect "$image" >/dev/null 2>&1; then
        state="INSTALLED"
    else
        state="NOT_INSTALLED"
    fi

    echo "APP=$slug"
    echo "RUNTIME_PROFILE=$profile"
    echo "PHP_VERSION=$php_version"
    echo "RUNTIME_IMAGE=$image"
    echo "RUNTIME_STATE=$state"
}

set_runtime_profile_app() {
    slug="$1"
    profile="$2"
    dir="$(app_root "$slug")"

    [ -d "$dir" ] ||         die "application is not installed: $slug"

    validate_runtime_profile "$profile"

    old="$(app_runtime_profile "$slug")"

    if [ "$old" = "$profile" ]; then
        echo "APP=$slug"
        echo "RUNTIME_PROFILE=$profile"
        echo "RUNTIME_CHANGE=NONE"
        return
    fi

    write_runtime_profile "$slug" "$profile"

    image="$(runtime_image_for_profile "$profile")"

    echo "APP=$slug"
    echo "OLD_RUNTIME_PROFILE=$old"
    echo "NEW_RUNTIME_PROFILE=$profile"

    if docker image inspect "$image" >/dev/null 2>&1; then
        echo "RUNTIME_IMAGE_STATE=INSTALLED"
    else
        echo "RUNTIME_IMAGE_STATE=BUILD_REQUIRED"
    fi

    echo "APPLY_REQUIRED=YES"
}

compose_cmd() {
    slug="$1"
    shift

    docker compose \
        --project-name "secure-$slug" \
        --file "$(app_root "$slug")/compose.yaml" \
        "$@"
}

ensure_layout() {
    slug="$1"
    requested_profile="${2:-}"
    dir="$(app_root "$slug")"

    load_runtime

    if [ -z "$requested_profile" ]; then
        requested_profile="$DEFAULT_RUNTIME_PROFILE"
    fi

    validate_runtime_profile "$requested_profile"

    mkdir -p \
        "$dir/config/tls" \
        "$dir/data/storage/app/public" \
        "$dir/data/storage/framework/cache/data" \
        "$dir/data/storage/framework/sessions" \
        "$dir/data/storage/framework/views" \
        "$dir/data/storage/logs" \
        "$dir/data/bootstrap-cache" \
        "$dir/data/redis" \
        "$dir/releases" \
        "$dir/state"

    if [ ! -f "$dir/config/tuning.cfg" ]; then
        install -m 0644 \
            "$SHARE/tuning.cfg" \
            "$dir/config/tuning.cfg"

        sed -i \
            "s/^APP_SLUG=.*/APP_SLUG=$slug/" \
            "$dir/config/tuning.cfg"
    fi

    if [ ! -f "$dir/config/runtime.cfg" ]; then
        printf 'RUNTIME_PROFILE=%s\n' \
            "$requested_profile" \
            > "$dir/config/runtime.cfg"

        chmod 0644 "$dir/config/runtime.cfg"
    fi

    if [ ! -f "$dir/config/.env" ]; then
        cat > "$dir/config/.env" <<EOF_ENV
APP_NAME="$slug"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME

LOG_CHANNEL=stderr
LOG_LEVEL=warning

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

EOF_ENV

        chmod 0600 "$dir/config/.env"
    fi
}

prepare_permissions() {
    slug="$1"
    dir="$(app_root "$slug")"
    cfg="$dir/config/tuning.cfg"

    uid="$(cfg_get "$cfg" APP_RUNTIME_UID 10001)"
    gid="$(cfg_get "$cfg" APP_RUNTIME_GID 10001)"

    echo "$uid" | grep -Eq '^[0-9]+$' || die "invalid APP_RUNTIME_UID"
    echo "$gid" | grep -Eq '^[0-9]+$' || die "invalid APP_RUNTIME_GID"

    chown "$uid:$gid" "$dir/config/.env"
    chmod 0600 "$dir/config/.env"

    chown -R "$uid:$gid" \
        "$dir/data/storage" \
        "$dir/data/bootstrap-cache"
}

render_compose() {
    slug="$1"

    dir="$(app_root "$slug")"
    cfg="$dir/config/tuning.cfg"

    [ -L "$dir/current" ] || \
        die "no current release for $slug"

    [ -r "$cfg" ] || \
        die "missing tuning.cfg for $slug"

    [ -r "$dir/config/.env" ] || \
        die "missing .env for $slug"

    load_runtime

    runtime_cfg="$dir/config/runtime.cfg"

    if [ ! -r "$runtime_cfg" ]; then
        write_runtime_profile "$slug" "$DEFAULT_RUNTIME_PROFILE"
    fi

    runtime_profile="$(app_runtime_profile "$slug")"

    validate_runtime_profile "$runtime_profile"
    ensure_runtime_profile "$runtime_profile"

    runtime_image="$(runtime_image_for_profile "$runtime_profile")"

    docker_cpus="$(cfg_get "$cfg" DOCKER_CPUS 0)"
    docker_memory="$(cfg_get "$cfg" DOCKER_MEMORY 0)"
    docker_reservation="$(cfg_get "$cfg" DOCKER_MEMORY_RESERVATION 0)"
    docker_pids="$(cfg_get "$cfg" DOCKER_PIDS_LIMIT 4096)"
    docker_shm="$(cfg_get "$cfg" DOCKER_SHM_SIZE 256M)"
    redis_memory="$(cfg_get "$cfg" REDIS_DOCKER_MEMORY 768M)"

    {
        cat <<EOF_YAML
services:
  web:
    image: $runtime_image
    container_name: secure-app-$slug-web
    restart: "no"
EOF_YAML

        [ "$docker_cpus" = "0" ] || \
            echo "    cpus: \"$docker_cpus\""

        [ "$docker_memory" = "0" ] || \
            echo "    mem_limit: \"$docker_memory\""

        [ "$docker_reservation" = "0" ] || \
            echo "    mem_reservation: \"$docker_reservation\""

        [ "$docker_pids" = "0" ] || \
            echo "    pids_limit: $docker_pids"

        [ "$docker_shm" = "0" ] || \
            echo "    shm_size: \"$docker_shm\""

        cat <<EOF_YAML
    volumes:
      - $dir/current/app:/opt/app:ro
      - $dir/config:/run/app-config:ro
      - $dir/data/storage:/opt/app/storage
      - $dir/data/bootstrap-cache:/opt/app/bootstrap/cache
    depends_on:
      - redis
    networks:
      - gateway
      - private

  redis:
    image: $REDIS_IMAGE
    container_name: secure-app-$slug-redis
    restart: "no"
EOF_YAML

        [ "$redis_memory" = "0" ] || \
            echo "    mem_limit: \"$redis_memory\""

        cat <<EOF_YAML
    volumes:
      - $dir/config/tuning.cfg:/run/app-config/tuning.cfg:ro
      - $dir/data/redis:/data
    networks:
      - private

networks:
  gateway:
    external: true
    name: $GATEWAY_NETWORK

  private:
    name: secure-app-$slug-private
    internal: true
EOF_YAML
    } > "$dir/compose.yaml"
}

cert_public_hash() {
    openssl x509 \
        -in "$1" \
        -pubkey \
        -noout 2>/dev/null |
    openssl pkey \
        -pubin \
        -outform DER 2>/dev/null |
    sha256sum |
    awk '{print $1}'
}

key_public_hash() {
    openssl pkey \
        -in "$1" \
        -pubout \
        -outform DER 2>/dev/null |
    sha256sum |
    awk '{print $1}'
}

file_hash() {
    file="$1"

    if [ -f "$file" ]; then
        sha256sum "$file" | awk '{print $1}'
    else
        printf '%s' "MISSING"
    fi
}

validate_tls_config() {
    slug="$1"
    dir="$(app_root "$slug")"
    cfg="$dir/config/tuning.cfg"

    domain="$(cfg_get "$cfg" APP_DOMAIN CHANGE_ME)"

    [ "$domain" != "CHANGE_ME" ] || \
        die "set APP_DOMAIN in $cfg"

    echo "$domain" | grep -Eq '^[A-Za-z0-9.-]+$' || \
        die "invalid APP_DOMAIN: $domain"

    cert="$dir/config/tls/ssl.crt"
    key="$dir/config/tls/ssl.key"
    ca="$dir/config/tls/ca.crt"

    [ -r "$cert" ] || \
        die "missing TLS certificate: $cert"

    [ -r "$key" ] || \
        die "missing TLS private key: $key"

    cert_hash="$(cert_public_hash "$cert")"
    key_hash="$(key_public_hash "$key")"

    [ -n "$cert_hash" ] || \
        die "unable to read TLS certificate"

    [ -n "$key_hash" ] || \
        die "unable to read TLS private key"

    [ "$cert_hash" = "$key_hash" ] || \
        die "TLS certificate and private key do not match"

    openssl x509 \
        -in "$cert" \
        -noout \
        -checkend 0 \
        >/dev/null 2>&1 || \
        die "TLS certificate is expired"

    openssl x509 \
        -in "$cert" \
        -noout \
        -checkhost "$domain" \
        >/dev/null 2>&1 || \
        die "TLS certificate does not contain domain: $domain"

    echo "TLS_DOMAIN=$domain"
    echo "TLS_NOT_BEFORE=$(
        openssl x509 \
            -in "$cert" \
            -noout \
            -startdate |
        cut -d= -f2-
    )"
    echo "TLS_NOT_AFTER=$(
        openssl x509 \
            -in "$cert" \
            -noout \
            -enddate |
        cut -d= -f2-
    )"

    if [ -r "$ca" ]; then
        echo "TLS_CA=PRESENT"
    else
        echo "TLS_CA=NOT_PRESENT"
    fi

    echo "TLS_VALIDATION=PASS"
}

state_value() {
    file="$1"
    key="$2"

    cfg_get "$file" "$key" ""
}

build_change_plan() {
    slug="$1"
    dir="$(app_root "$slug")"
    state="$dir/state/applied.env"

    PLAN_STATE="APPLIED"
    PLAN_ENV="UNCHANGED"
    PLAN_TUNING="UNCHANGED"
    PLAN_TLS="UNCHANGED"
    PLAN_RUNTIME="UNCHANGED"
    PLAN_RELEASE="UNCHANGED"
    PLAN_DOMAIN="UNCHANGED"
    PLAN_WEB_RECREATE="NO"
    PLAN_REDIS_RECREATE="NO"
    PLAN_GATEWAY_RELOAD="NO"

    current_env="$(file_hash "$dir/config/.env")"
    current_tuning="$(file_hash "$dir/config/tuning.cfg")"
    current_cert="$(file_hash "$dir/config/tls/ssl.crt")"
    current_key="$(file_hash "$dir/config/tls/ssl.key")"
    current_ca="$(file_hash "$dir/config/tls/ca.crt")"
    current_runtime="$(app_runtime_profile "$slug")"
    current_release="$(readlink "$dir/current" 2>/dev/null || true)"
    current_domain="$(
        cfg_get \
            "$dir/config/tuning.cfg" \
            APP_DOMAIN \
            CHANGE_ME
    )"

    if [ ! -r "$state" ]; then
        PLAN_STATE="NEVER_APPLIED"
        PLAN_ENV="CHANGED"
        PLAN_TUNING="CHANGED"
        PLAN_TLS="CHANGED"
        PLAN_RUNTIME="CHANGED"
        PLAN_RELEASE="CHANGED"
        PLAN_DOMAIN="CHANGED"
        PLAN_WEB_RECREATE="YES"
        PLAN_REDIS_RECREATE="YES"
        PLAN_GATEWAY_RELOAD="YES"
        return
    fi

    previous_env="$(state_value "$state" ENV_SHA256)"
    previous_tuning="$(state_value "$state" TUNING_SHA256)"
    previous_cert="$(state_value "$state" TLS_CERT_SHA256)"
    previous_key="$(state_value "$state" TLS_KEY_SHA256)"
    previous_ca="$(state_value "$state" TLS_CA_SHA256)"
    previous_runtime="$(state_value "$state" RUNTIME_PROFILE)"
    previous_release="$(state_value "$state" CURRENT_RELEASE)"
    previous_domain="$(state_value "$state" APP_DOMAIN)"

    if [ "$current_env" != "$previous_env" ]; then
        PLAN_ENV="CHANGED"
        PLAN_WEB_RECREATE="YES"
    fi

    if [ "$current_tuning" != "$previous_tuning" ]; then
        PLAN_TUNING="CHANGED"
        PLAN_WEB_RECREATE="YES"
        PLAN_REDIS_RECREATE="YES"
        PLAN_GATEWAY_RELOAD="YES"
    fi

    if [ "$current_cert" != "$previous_cert" ] || \
       [ "$current_key" != "$previous_key" ] || \
       [ "$current_ca" != "$previous_ca" ]; then
        PLAN_TLS="CHANGED"
        PLAN_GATEWAY_RELOAD="YES"
    fi

    if [ "$current_runtime" != "$previous_runtime" ]; then
        PLAN_RUNTIME="CHANGED"
        PLAN_WEB_RECREATE="YES"
    fi

    if [ "$current_release" != "$previous_release" ]; then
        PLAN_RELEASE="CHANGED"
        PLAN_WEB_RECREATE="YES"
    fi

    if [ "$current_domain" != "$previous_domain" ]; then
        PLAN_DOMAIN="CHANGED"
        PLAN_GATEWAY_RELOAD="YES"
    fi
}

show_change_plan() {
    slug="$1"

    build_change_plan "$slug"

    echo "APP=$slug"
    echo "STATE=$PLAN_STATE"
    echo "ENV=$PLAN_ENV"
    echo "TUNING=$PLAN_TUNING"
    echo "TLS=$PLAN_TLS"
    echo "RUNTIME=$PLAN_RUNTIME"
    echo "RELEASE=$PLAN_RELEASE"
    echo "DOMAIN=$PLAN_DOMAIN"
    echo
    echo "WEB_RECREATE_REQUIRED=$PLAN_WEB_RECREATE"
    echo "REDIS_RECREATE_REQUIRED=$PLAN_REDIS_RECREATE"
    echo "GATEWAY_RELOAD_REQUIRED=$PLAN_GATEWAY_RELOAD"
}

write_applied_state() {
    slug="$1"
    dir="$(app_root "$slug")"
    state="$dir/state/applied.env"
    temp="$state.new"

    mkdir -p "$dir/state"

    cat > "$temp" <<EOF_STATE
ENV_SHA256=$(file_hash "$dir/config/.env")
TUNING_SHA256=$(file_hash "$dir/config/tuning.cfg")
TLS_CERT_SHA256=$(file_hash "$dir/config/tls/ssl.crt")
TLS_KEY_SHA256=$(file_hash "$dir/config/tls/ssl.key")
TLS_CA_SHA256=$(file_hash "$dir/config/tls/ca.crt")
RUNTIME_PROFILE=$(app_runtime_profile "$slug")
CURRENT_RELEASE=$(readlink "$dir/current")
APP_DOMAIN=$(cfg_get "$dir/config/tuning.cfg" APP_DOMAIN CHANGE_ME)
EOF_STATE

    chmod 0600 "$temp"
    mv "$temp" "$state"
}

preflight_app() {
    slug="$1"
    dir="$(app_root "$slug")"

    valid_slug "$slug" || \
        die "invalid application slug: $slug"

    [ -d "$dir" ] || \
        die "application is not installed: $slug"

    [ -L "$dir/current" ] || \
        die "current release is missing"

    [ -r "$dir/current/app/artisan" ] || \
        die "Laravel artisan is missing"

    [ -r "$dir/current/app/public/index.php" ] || \
        die "public/index.php is missing"

    [ -r "$dir/config/.env" ] || \
        die ".env is missing"

    [ -r "$dir/config/tuning.cfg" ] || \
        die "tuning.cfg is missing"

    profile="$(app_runtime_profile "$slug")"

    validate_runtime_profile "$profile"

    echo "APP=$slug"
    echo "CURRENT_RELEASE=$(readlink "$dir/current")"
    echo "RUNTIME_PROFILE=$profile"

    validate_tls_config "$slug"

    echo "PREFLIGHT=PASS"
}

register_gateway() {
    slug="$1"

    dir="$(app_root "$slug")"
    cfg="$dir/config/tuning.cfg"

    domain="$(cfg_get "$cfg" APP_DOMAIN CHANGE_ME)"
    tls_min="$(cfg_get "$cfg" CADDY_TLS_MIN tls1.2)"
    tls_max="$(cfg_get "$cfg" CADDY_TLS_MAX tls1.3)"

    [ "$domain" != "CHANGE_ME" ] || \
        die "set APP_DOMAIN in $cfg"

    echo "$domain" | grep -Eq '^[A-Za-z0-9.-]+$' || \
        die "invalid APP_DOMAIN: $domain"

    case "$tls_min" in
        tls1.2|tls1.3) ;;
        *) die "invalid CADDY_TLS_MIN: $tls_min" ;;
    esac

    case "$tls_max" in
        tls1.2|tls1.3) ;;
        *) die "invalid CADDY_TLS_MAX: $tls_max" ;;
    esac

    cert="$dir/config/tls/ssl.crt"
    key="$dir/config/tls/ssl.key"
    ca="$dir/config/tls/ca.crt"

    [ -r "$cert" ] || \
        die "missing TLS certificate: $cert"

    [ -r "$key" ] || \
        die "missing TLS private key: $key"

    cert_hash="$(cert_public_hash "$cert")"
    key_hash="$(key_public_hash "$key")"

    [ -n "$cert_hash" ] || \
        die "unable to read TLS certificate"

    [ "$cert_hash" = "$key_hash" ] || \
        die "TLS certificate and private key do not match"

    target_tls="$GATEWAY_DIR/tls/$slug"

    mkdir -p \
        "$GATEWAY_DIR/apps" \
        "$target_tls"

    if [ -r "$ca" ]; then
        cat "$cert" "$ca" > "$target_tls/fullchain.pem"
    else
        install -m 0644 \
            "$cert" \
            "$target_tls/fullchain.pem"
    fi

    install -m 0600 \
        "$key" \
        "$target_tls/ssl.key"

    fragment="$GATEWAY_DIR/apps/$slug.caddy"
    backup="$fragment.previous"
    temp="$fragment.new"

    if [ -f "$fragment" ]; then
        cp "$fragment" "$backup"
    else
        rm -f "$backup"
    fi

    cat > "$temp" <<EOF_CADDY
https://$domain {
    tls /etc/caddy/tls/$slug/fullchain.pem /etc/caddy/tls/$slug/ssl.key {
        protocols $tls_min $tls_max
    }

    encode zstd gzip

    reverse_proxy secure-app-$slug-web:8080
}
EOF_CADDY

    mv "$temp" "$fragment"

    if ! docker exec "$GATEWAY_CONTAINER" \
        caddy validate \
        --config /etc/caddy/Caddyfile \
        --adapter caddyfile >/dev/null
    then
        if [ -f "$backup" ]; then
            mv "$backup" "$fragment"
        else
            rm -f "$fragment"
        fi

        die "gateway Caddy validation failed"
    fi

    rm -f "$backup"

    docker exec "$GATEWAY_CONTAINER" \
        caddy reload \
        --force \
        --config /etc/caddy/Caddyfile \
        --adapter caddyfile

    echo "GATEWAY_DOMAIN=$domain"
    echo "GATEWAY=APPLIED"
}

install_pack() {
    pack="$1"

    [ -r "$pack" ] || \
        die "package not readable: $pack"

    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT INT TERM

    tar -xf "$pack" -C "$tmp"

    manifest="$tmp/manifest.env"

    [ -r "$manifest" ] || \
        die "package manifest missing"

    format="$(cfg_get "$manifest" SAPP_FORMAT "")"
    slug="$(cfg_get "$manifest" APP_SLUG "")"
    version="$(cfg_get "$manifest" APP_VERSION "")"
    security_mode="$(cfg_get "$manifest" SECURITY_MODE "")"

    load_runtime

    runtime_profile="$(
        cfg_get \
            "$manifest" \
            RUNTIME_PROFILE \
            "$DEFAULT_RUNTIME_PROFILE"
    )"

    validate_runtime_profile "$runtime_profile"

    [ "$format" = "1" ] || \
        die "unsupported SAPP_FORMAT: $format"

    valid_slug "$slug" || \
        die "invalid APP_SLUG in package: $slug"

    echo "$version" | grep -Eq '^[A-Za-z0-9._-]+$' || \
        die "invalid APP_VERSION in package: $version"

    [ "$security_mode" = "TEST_PLAINTEXT" ] || \
        die "this appctl milestone accepts TEST_PLAINTEXT packages only"

    (
        cd "$tmp"
        sha256sum -c checksums.sha256
    )

    ensure_layout "$slug" "$runtime_profile"

    dir="$(app_root "$slug")"
    release="$dir/releases/$version"

    [ ! -e "$release" ] || \
        die "release already exists: $release"

    mkdir -p "$release/app"

    tar \
        -xzf "$tmp/payload/app.tar.gz" \
        -C "$release/app"

    install -m 0644 \
        "$manifest" \
        "$release/manifest.env"

    [ -f "$release/app/artisan" ] || \
        die "Laravel artisan missing from release"

    [ -f "$release/app/public/index.php" ] || \
        die "public/index.php missing from release"

    [ -L "$release/app/.env" ] || \
        die "release .env symlink missing"

    [ "$(readlink "$release/app/.env")" = "/run/app-config/.env" ] || \
        die "release .env symlink is invalid"

    if [ -L "$dir/current" ]; then
        old="$(readlink "$dir/current")"

        ln -sfn "$old" "$dir/previous.new"
        mv -Tf "$dir/previous.new" "$dir/previous"
    fi

    ln -sfn "releases/$version" "$dir/current.new"
    mv -Tf "$dir/current.new" "$dir/current"

    prepare_permissions "$slug"

    echo
    echo "=== APPLICATION INSTALLED ==="
    echo "APP_SLUG=$slug"
    echo "APP_VERSION=$version"
    echo "RUNTIME_PROFILE=$runtime_profile"
    echo "SECURITY_MODE=$security_mode"
    echo "APP_ROOT=$dir"
    echo
    echo "EDIT=$dir/config/.env"
    echo "EDIT=$dir/config/tuning.cfg"
    echo "TLS=$dir/config/tls/"
    echo
    echo "NEXT=sudo appctl apply $slug"
    echo
    echo "WARNING=TEST_PLAINTEXT package. Protected loader is not implemented yet."
}

apply_app() {
    slug="$1"

    require_unlocked
    preflight_app "$slug" >/dev/null
    build_change_plan "$slug"

    prepare_permissions "$slug"
    render_compose "$slug"

    if [ "$PLAN_WEB_RECREATE" = "YES" ] && \
       [ "$PLAN_REDIS_RECREATE" = "YES" ]; then
        compose_cmd "$slug" \
            up -d --force-recreate
    elif [ "$PLAN_REDIS_RECREATE" = "YES" ]; then
        compose_cmd "$slug" \
            up -d --force-recreate redis

        compose_cmd "$slug" \
            up -d
    elif [ "$PLAN_WEB_RECREATE" = "YES" ]; then
        compose_cmd "$slug" \
            up -d --force-recreate web
    else
        compose_cmd "$slug" \
            up -d
    fi

    if [ "$PLAN_GATEWAY_RELOAD" = "YES" ]; then
        register_gateway "$slug"
    fi

    write_applied_state "$slug"

    echo
    echo "APP=$slug"
    echo "WEB_RECREATED=$PLAN_WEB_RECREATE"
    echo "REDIS_RECREATED=$PLAN_REDIS_RECREATE"
    echo "GATEWAY_RELOADED=$PLAN_GATEWAY_RELOAD"
    echo "APPLY=COMPLETE"
}

rollback_app() {
    slug="$1"
    dir="$(app_root "$slug")"

    [ -L "$dir/current" ] || \
        die "current release missing"

    [ -L "$dir/previous" ] || \
        die "previous release missing"

    current="$(readlink "$dir/current")"
    previous="$(readlink "$dir/previous")"

    ln -sfn "$previous" "$dir/current.new"
    mv -Tf "$dir/current.new" "$dir/current"

    ln -sfn "$current" "$dir/previous.new"
    mv -Tf "$dir/previous.new" "$dir/previous"

    apply_app "$slug"
}

status_app() {
    slug="$1"
    dir="$(app_root "$slug")"

    [ -d "$dir" ] || \
        die "application is not installed: $slug"

    echo "APP=$slug"

    if [ -L "$dir/current" ]; then
        echo "CURRENT=$(readlink "$dir/current")"
    fi

    if [ -L "$dir/previous" ]; then
        echo "PREVIOUS=$(readlink "$dir/previous")"
    fi

    runtime_profile="$(app_runtime_profile "$slug")"

    echo "RUNTIME_PROFILE=$runtime_profile"
    echo "RUNTIME_IMAGE=$(runtime_image_for_profile "$runtime_profile")"

    compose_cmd "$slug" ps
}

list_apps() {
    [ -d "$ROOT" ] || exit 0

    for dir in "$ROOT"/*
    do
        [ -d "$dir" ] || continue

        slug="$(basename "$dir")"

        [ "$slug" = "_gateway" ] && continue

        if [ -L "$dir/current" ]; then
            printf '%s\t%s\n' \
                "$slug" \
                "$(readlink "$dir/current")"
        else
            printf '%s\t%s\n' \
                "$slug" \
                "NO_RELEASE"
        fi
    done
}

