        echo "Appliance: UNLOCKED"
        echo
        echo "1. Manage installed application"
        echo "2. Install application package"
        echo "3. Runtime management"
        echo "4. Server health check"
        echo "5. List installed applications"
        echo "6. Lock applications"
        echo "7. Exit"
        echo

        choice="$(read_choice 'Select: ')"

        case "$choice" in
            1)
                select_app_menu
                ;;
            2)
                install_package_menu
                ;;
            3)
                runtime_menu
                ;;
            4)
                doctor
                pause_console
                ;;
            5)
                echo
                list_apps
                pause_console
                ;;
            6)
                echo
                confirm="$(read_choice 'Stop all applications and lock appliance? [y/N]: ')"

                case "$confirm" in
                    y|Y|yes|YES)
                        lock_appliance
                        return
                        ;;
                    *)
                        echo "Lock cancelled."
                        pause_console
                        ;;
                esac
                ;;
            7|q|Q)
                return
                ;;
            *)
                echo "Invalid selection."
                pause_console
                ;;
        esac
    done
}

usage() {
    cat <<'EOF_USAGE'
Usage:

  appctl doctor
  appctl list
  appctl unlock
  appctl lock

  appctl runtime-list
  appctl runtime-status <app-slug>
  appctl runtime-set <app-slug> <profile>
  appctl runtime-build <profile>

  appctl check <app-slug>

  appctl install <package.sapp>
  appctl deploy <package.sapp>

  appctl apply <app-slug>
  appctl start <app-slug>
  appctl stop <app-slug>
  appctl restart <app-slug>

  appctl status <app-slug>
  appctl logs <app-slug>

  appctl rollback <app-slug>
EOF_USAGE

    exit 1
}

need_root "$@"

command="${1:-}"

if [ ! -f "$INSTALL_MARKER" ]; then
    verify_product_session

    if [ "$command" != "lock" ]; then
        unlock_appliance
    fi
fi

if [ -z "$command" ]; then
    interactive_menu
    exit 0
fi

case "$command" in
    doctor)
        doctor
        ;;

    list)
        list_apps
        ;;

    unlock)
        [ "$#" -eq 1 ] || usage
        unlock_appliance
        ;;

    lock)
        [ "$#" -eq 1 ] || usage
        lock_appliance
        ;;

    runtime-list)
        [ "$#" -eq 1 ] || usage
        list_runtime_profiles
        ;;

    runtime-status)
        [ "$#" -eq 2 ] || usage
        runtime_status_app "$2"
        ;;

    runtime-set)
        [ "$#" -eq 3 ] || usage
        set_runtime_profile_app "$2" "$3"
        ;;

    runtime-build)
        [ "$#" -eq 2 ] || usage
        load_runtime
        ensure_runtime_profile "$2"
        echo "RUNTIME_PROFILE=$2"
        echo "RUNTIME_BUILD=COMPLETE"
        ;;

    check)
        [ "$#" -eq 2 ] || usage
        preflight_app "$2"
        echo
        show_change_plan "$2"
        ;;

    install|deploy)
        [ "$#" -eq 2 ] || usage
        install_pack "$2"
        ;;

    apply)
        [ "$#" -eq 2 ] || usage
        apply_app "$2"
        ;;

    start)
        [ "$#" -eq 2 ] || usage
        render_compose "$2"
        prepare_permissions "$2"
        compose_cmd "$2" up -d
        register_gateway "$2"
        ;;

    stop)
        [ "$#" -eq 2 ] || usage
        compose_cmd "$2" stop
        ;;

    restart)
        [ "$#" -eq 2 ] || usage
        prepare_permissions "$2"
        compose_cmd "$2" restart
        register_gateway "$2"
        ;;

    status)
        [ "$#" -eq 2 ] || usage
        status_app "$2"
        ;;

    logs)
        [ "$#" -eq 2 ] || usage
        compose_cmd "$2" logs --tail=200
        ;;

    rollback)
        [ "$#" -eq 2 ] || usage
        rollback_app "$2"
        ;;

    *)
        usage
        ;;
esac
