change_runtime_menu() {
    slug="$1"

    echo
    echo "Available runtime profiles"
    echo
    list_runtime_profiles
    echo

    current="$(app_runtime_profile "$slug")"

    echo
    echo "Current runtime: $current"
    echo

    profile="$(read_choice 'New runtime profile or B to cancel: ')"

    case "$profile" in
        b|B|"")
            return
            ;;
    esac

    validate_runtime_profile "$profile" || return

    if [ "$profile" = "$current" ]; then
        echo "Runtime is already set to $profile."
        pause_console
        return
