validate_tls_source_files() {
    cert="$1"
    key="$2"
    ca="$3"
    domain="$4"

    [ -r "$cert" ] || {
        echo "ERROR: certificate path is not readable: $cert"
        return 1
    }

    [ -r "$key" ] || {
        echo "ERROR: private key path is not readable: $key"
        return 1
    }

    cert_hash="$(cert_public_hash "$cert")"
    key_hash="$(key_public_hash "$key")"

    [ -n "$cert_hash" ] || {
        echo "ERROR: certificate could not be parsed"
        return 1
    }

    [ -n "$key_hash" ] || {
        echo "ERROR: private key could not be parsed"
        return 1
    }

    [ "$cert_hash" = "$key_hash" ] || {
        echo "ERROR: certificate and private key do not match"
        return 1
    }

    openssl x509 \
        -in "$cert" \
        -noout \
        -checkend 0 \
        >/dev/null 2>&1 || {
            echo "ERROR: certificate is expired"
            return 1
        }

    openssl x509 \
        -in "$cert" \
        -noout \
        -checkhost "$domain" \
        >/dev/null 2>&1 || {
            echo "ERROR: certificate does not contain domain: $domain"
            echo
            echo "Certificate names:"
            openssl x509 \
                -in "$cert" \
                -noout \
                -ext subjectAltName 2>/dev/null || true
            return 1
        }

    if [ -n "$ca" ]; then
        [ -r "$ca" ] || {
            echo "ERROR: CA/fullchain path is not readable: $ca"
            return 1
        }

        openssl x509 \
            -in "$ca" \
            -noout \
            >/dev/null 2>&1 || {
                echo "ERROR: CA/fullchain file could not be parsed"
                return 1
            }
    fi

    echo "CERTIFICATE_KEY_MATCH=PASS"
    echo "CERTIFICATE_DOMAIN_MATCH=PASS"
    echo "CERTIFICATE_EXPIRY=PASS"
    echo "DOMAIN=$domain"
    echo "NOT_BEFORE=$(
        openssl x509 \
            -in "$cert" \
            -noout \
            -startdate |
        cut -d= -f2-
    )"
    echo "NOT_AFTER=$(
        openssl x509 \
            -in "$cert" \
            -noout \
            -enddate |
        cut -d= -f2-
    )"

    return 0
}

update_tls_menu() {
    slug="$1"
    dir="$(app_root "$slug")"
    cfg="$dir/config/tuning.cfg"
    domain="$(cfg_get "$cfg" APP_DOMAIN CHANGE_ME)"

    echo
    echo "Application domain: $domain"
    echo

    [ "$domain" != "CHANGE_ME" ] || {
        echo "Set APP_DOMAIN in tuning.cfg before installing TLS."
        pause_console
        return
    }

    cert="$(read_choice 'Certificate path: ')"

    [ -n "$cert" ] || {
        echo "No certificate path entered."
        pause_console
        return
    }

    key="$(read_choice 'Private key path: ')"

    [ -n "$key" ] || {
        echo "No private key path entered."
        pause_console
        return
    }

    ca="$(read_choice 'CA/fullchain path, or press Enter if none: ')"

    echo
    echo "Validating TLS files."
    echo

    if ! validate_tls_source_files \
        "$cert" \
        "$key" \
        "$ca" \
        "$domain"
    then
        echo
        echo "TLS_UPDATE=REJECTED"
        echo "Existing TLS files were not changed."
        pause_console
        return
    fi

    echo
    confirm="$(read_choice 'Install these TLS files? [y/N]: ')"

    case "$confirm" in
        y|Y|yes|YES)
            ;;
        *)
            echo "TLS update cancelled."
            pause_console
            return
            ;;
    esac

    tls="$dir/config/tls"
    tmp="$(mktemp -d)"

    install -m 0644 "$cert" "$tmp/ssl.crt"
    install -m 0600 "$key" "$tmp/ssl.key"

    if [ -n "$ca" ]; then
        install -m 0644 "$ca" "$tmp/ca.crt"
    fi

    install -d -m 0755 "$tls"

    install -m 0644 \
        "$tmp/ssl.crt" \
        "$tls/ssl.crt"

    install -m 0600 \
        "$tmp/ssl.key" \
        "$tls/ssl.key"

    if [ -f "$tmp/ca.crt" ]; then
        install -m 0644 \
            "$tmp/ca.crt" \
            "$tls/ca.crt"
    else
        rm -f "$tls/ca.crt"
    fi

    rm -rf "$tmp"

    echo
    echo "TLS_UPDATE=INSTALLED"

    offer_apply_changes "$slug"
}

