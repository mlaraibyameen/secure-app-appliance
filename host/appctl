    if docker image inspect "$image" >/dev/null 2>&1; then
        echo "Runtime image already exists."
    else
        echo "Runtime image is not installed."
        confirm="$(read_choice 'Build it now? [y/N]: ')"

        case "$confirm" in
            y|Y|yes|YES)
                ensure_runtime_profile "$profile"
                ;;
            *)
                echo "Runtime change cancelled."
                pause_console
                return
                ;;
        esac
    fi

    echo
    echo "Application: $slug"
    echo "Current runtime: $current"
    echo "New runtime: $profile"
    echo

    confirm="$(read_choice 'Switch runtime and recreate the application? [y/N]: ')"

    case "$confirm" in
        y|Y|yes|YES)
            write_runtime_profile "$slug" "$profile"
