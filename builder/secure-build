#!/bin/sh
set -eu

usage() {
    cat <<'USAGE'
Usage:
  ./builder/secure-build --protected <app-path> <app-slug> <version>
  ./builder/secure-build --test <app-path> <app-slug> <version>

Environment:
  RUNTIME_PROFILE=php84
  SWS_SIGNING_KEY=/path/to/product-private-key
USAGE
    exit 1
}

MODE="${1:-}"

case "$MODE" in
    --protected|--test)
        ;;
    *)
        usage
        ;;
esac

[ "$#" -eq 4 ] || usage

APP_PATH="$(realpath "$2")"
APP_SLUG="$3"
APP_VERSION="$4"

echo "$APP_SLUG" | grep -Eq '^[a-z0-9][a-z0-9-]*$' || {
    echo "ERROR: invalid app slug: $APP_SLUG" >&2
    exit 1
}

echo "$APP_VERSION" | grep -Eq '^[A-Za-z0-9._-]+$' || {
    echo "ERROR: invalid version: $APP_VERSION" >&2
    exit 1
}

[ -f "$APP_PATH/artisan" ] || {
    echo "ERROR: artisan not found: $APP_PATH" >&2
    exit 1
}

[ -f "$APP_PATH/public/index.php" ] || {
    echo "ERROR: public/index.php not found" >&2
    exit 1
}

[ -f "$APP_PATH/vendor/autoload.php" ] || {
    echo "ERROR: vendor/autoload.php not found" >&2
    exit 1
}

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

RUNTIME_PROFILE="${RUNTIME_PROFILE:-php84}"

[ -r "$ROOT/runtime/profiles/$RUNTIME_PROFILE.env" ] || {
    echo "ERROR: unsupported runtime profile: $RUNTIME_PROFILE" >&2
    exit 1
}

SWS_SIGNING_KEY="${SWS_SIGNING_KEY:-$ROOT/keys/product_unlock_ed25519}"
PRODUCT_PUBLIC_KEY="$ROOT/keys/product_unlock_ed25519.pub"

if [ "$MODE" = "--protected" ]; then
    [ -r "$SWS_SIGNING_KEY" ] || {
        echo "ERROR: SWS signing key not readable: $SWS_SIGNING_KEY" >&2
        exit 1
    }

    [ -r "$PRODUCT_PUBLIC_KEY" ] || {
        echo "ERROR: product public key not readable: $PRODUCT_PUBLIC_KEY" >&2
        exit 1
    }

    command -v ssh-keygen >/dev/null 2>&1 || {
        echo "ERROR: ssh-keygen missing" >&2
        exit 1
    }

    command -v openssl >/dev/null 2>&1 || {
        echo "ERROR: openssl missing" >&2
        exit 1
    }

    command -v python3 >/dev/null 2>&1 || {
        echo "ERROR: python3 missing" >&2
        exit 1
    }
fi

WORK="$ROOT/build/packs/$APP_SLUG/$APP_VERSION"
STAGE="$WORK/app"
PACKAGE="$WORK/package"
DIST="$ROOT/dist"

rm -rf "$WORK"

mkdir -p \
    "$STAGE" \
    "$PACKAGE/payload" \
    "$DIST"

echo "==> Staging $APP_SLUG $APP_VERSION"

rsync -a \
    --delete \
    --exclude='.git/' \
    --exclude='.env' \
    --exclude='.env.*' \
    --exclude='/storage/***' \
    --exclude='node_modules/' \
    --exclude='*.sql' \
    --exclude='*.tar' \
    --exclude='*.tar.gz' \
    --exclude='*.tar.zst' \
    "$APP_PATH/" \
    "$STAGE/"

mkdir -p "$STAGE/storage"

rm -rf "$STAGE/public/storage"
ln -s ../storage/app/public "$STAGE/public/storage"

rm -f "$STAGE/.env"
ln -s /run/app-config/.env "$STAGE/.env"

echo
echo "=== SECURITY CHECKS ==="

if [ "$(readlink "$STAGE/.env")" = "/run/app-config/.env" ]; then
    echo "ENV_SYMLINK=PASS"
else
    echo "ENV_SYMLINK=FAIL"
    exit 1
fi

if [ -L "$STAGE/public/storage" ] &&
   [ "$(readlink "$STAGE/public/storage")" = "../storage/app/public" ]; then
    echo "PUBLIC_STORAGE_LINK=PASS"
else
    echo "PUBLIC_STORAGE_LINK=FAIL"
    exit 1
fi

if find "$STAGE" -type f -name '.env*' -print -quit | grep -q .; then
    echo "ENV_FILE_INCLUDED=YES"
    exit 1
else
    echo "ENV_FILE_INCLUDED=NO"
fi

if find "$STAGE" -type f \( \
    -name '*.sql' \
    -o -name '*.tar' \
    -o -name '*.tar.gz' \
    -o -name '*.tar.zst' \
\) -print -quit | grep -q .; then
    echo "FORBIDDEN_FILE_INCLUDED=YES"
    exit 1
else
    echo "FORBIDDEN_FILE_INCLUDED=NO"
fi

SECURITY_MODE="TEST_PLAINTEXT"
SWS_FORMAT=""
SWS_NAMESPACE=""
SWS_CHALLENGE=""
SWS_KEY_FINGERPRINT=""

if [ "$MODE" = "--protected" ]; then
    echo
    echo "=== SWS SOURCE PROTECTION ==="

    python3 \
        "$ROOT/builder/sws-protect.py" \
        "$STAGE" \
        "$SWS_SIGNING_KEY" \
        "$APP_SLUG" \
        "$APP_VERSION" \
        "$RUNTIME_PROFILE"

    SECURITY_MODE="SWS_V1"
    SWS_FORMAT="1"
    SWS_NAMESPACE="secure-app-sws"
    SWS_CHALLENGE="secure-app-appliance:sws:v1:$APP_SLUG:$APP_VERSION:$RUNTIME_PROFILE"
    SWS_KEY_FINGERPRINT="$(
        ssh-keygen \
            -lf "$PRODUCT_PUBLIC_KEY" \
            -E sha256 |
        awk '{print $2}'
    )"
fi

echo
echo "==> Creating application payload"

tar \
    -C "$STAGE" \
    -czf "$PACKAGE/payload/app.tar.gz" \
    .

cat > "$PACKAGE/manifest.env" <<EOF_MANIFEST
SAPP_FORMAT=1
APP_SLUG=$APP_SLUG
APP_VERSION=$APP_VERSION
RUNTIME_PROFILE=$RUNTIME_PROFILE
SECURITY_MODE=$SECURITY_MODE
SWS_FORMAT=$SWS_FORMAT
SWS_NAMESPACE=$SWS_NAMESPACE
SWS_CHALLENGE=$SWS_CHALLENGE
SWS_KEY_FINGERPRINT=$SWS_KEY_FINGERPRINT
BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF_MANIFEST

(
    cd "$PACKAGE"
    sha256sum payload/app.tar.gz > checksums.sha256
)

OUTPUT="$DIST/$APP_SLUG-$APP_VERSION.sapp"

tar \
    -C "$PACKAGE" \
    -cf "$OUTPUT" \
    manifest.env \
    checksums.sha256 \
    payload

echo
echo "=== PACKAGE BUILT ==="
echo "APP_SLUG=$APP_SLUG"
echo "APP_VERSION=$APP_VERSION"
echo "RUNTIME_PROFILE=$RUNTIME_PROFILE"
echo "SECURITY_MODE=$SECURITY_MODE"

if [ "$SECURITY_MODE" = "SWS_V1" ]; then
    echo "SWS_FORMAT=$SWS_FORMAT"
    echo "SWS_NAMESPACE=$SWS_NAMESPACE"
    echo "SWS_CHALLENGE=$SWS_CHALLENGE"
    echo "SWS_KEY_FINGERPRINT=$SWS_KEY_FINGERPRINT"
fi

echo "OUTPUT=$OUTPUT"
sha256sum "$OUTPUT"

if [ "$MODE" = "--protected" ]; then
    rm -rf "$WORK"
    echo "PLAINTEXT_BUILD_STAGE=REMOVED"
else
    echo
    echo "WARNING=TEST_PLAINTEXT package"
fi
