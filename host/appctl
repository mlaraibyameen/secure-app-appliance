pause_console() {
    printf '\nPress Enter to continue...' >/dev/tty
    IFS= read -r _pause </dev/tty
}

read_choice() {
    prompt="$1"
    printf '%s' "$prompt" >/dev/tty
    IFS= read -r choice </dev/tty
    printf '%s' "$choice"
}

choose_app() {
    tmp="$(mktemp)"

    list_apps | awk '{print $1}' > "$tmp"

    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        echo "NO_APPS"
        return
    fi

    echo
    echo "Installed applications"
    echo

    n=1

    while IFS= read -r slug
    do
        printf '%s. %s\n' "$n" "$slug"
        n=$((n + 1))
    done < "$tmp"

    echo
    choice="$(read_choice 'Select application or B to go back: ')"

    case "$choice" in
        b|B)
            rm -f "$tmp"
            echo "BACK"
            return
            ;;
    esac

    echo "$choice" | grep -Eq '^[0-9]+$' || {
        rm -f "$tmp"
        echo "INVALID"
        return
    }

    slug="$(sed -n "${choice}p" "$tmp")"
    rm -f "$tmp"

    if [ -z "$slug" ]; then
        echo "INVALID"
        return
    fi

    echo "$slug"
}

run_editor() {
    file="$1"

    [ -e "$file" ] || \
        die "file does not exist: $file"

    if command -v nano >/dev/null 2>&1; then
        nano "$file"
    elif command -v vi >/dev/null 2>&1; then
        vi "$file"
    else
        die "no text editor is installed"
    fi
}

offer_apply_changes() {
    slug="$1"

